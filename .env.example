# ─── Database ───────────────────────────────────────────────
# Leave empty to use the local SQLite file (irizon_bonus.sqlite3).
# Set to a postgres:// URL to use Postgres instead.
DATABASE_URL=

# ─── SmartUp ERP integration ────────────────────────────────
SMARTUP_LOGIN=your-smartup-login
SMARTUP_PASSWORD=your-smartup-password
SMARTUP_FILIAL_ID=0000000
SMARTUP_USER_ID=0000000
SMARTUP_BEGIN_DATE=01.02.2022
SMARTUP_END_DATE=18.02.2029
SMARTUP_TIMEOUT=600
SMARTUP_MAX_RETRIES=3

# ─── Admin auth ─────────────────────────────────────────────
ADMIN_API_KEY=generate-a-strong-random-key
SESSION_TTL_MINUTES=1440

# ─── OTP / SMS ──────────────────────────────────────────────
# OTP_PROVIDER: "mock" (dev, uses MOCK_OTP_CODE) or "eskiz" (real SMS)
OTP_PROVIDER=mock
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_SIGNING_SECRET=change-me-strong-secret
MOCK_OTP_CODE=111111
MOCK_OTP_TTL_MINUTES=10

# Eskiz SMS (only needed when OTP_PROVIDER=eskiz)
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_SMS_TOKEN=your-eskiz-jwt-token
ESKIZ_SMS_FROM=4546
ESKIZ_CALLBACK_URL=

# ─── Firebase (push notifications) ──────────────────────────
# Path to the Firebase Admin service-account JSON (NOT committed).
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json

# ─── Misc ───────────────────────────────────────────────────
CLIENTS_CACHE_TTL_SEC=900
CATALOG_MANAGED_BY_XLSX=false
ORDERS_CACHE_TTL_SEC=30
# Comma-separated allowlist of browser origins. Do NOT use "*" in production.
# Include the admin panel URL and the mobile app's WebView origins:
#   https://<panel>.vercel.app  — admin panel
#   https://localhost           — Android WebView (Capacitor default androidScheme)
#   capacitor://localhost       — iOS WebView (Capacitor default iosScheme)
#   http://localhost            — local dev
CORS_ALLOW_ORIGINS=https://irizon-bonus-v0-1.vercel.app,https://localhost,capacitor://localhost,http://localhost
